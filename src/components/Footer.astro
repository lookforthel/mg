---
/**
 * Footer Component
 *
 * Unified footer with boxed and fullWidth variants.
 * Contains navigation links, resources, and creator info.
 */
import Logo from './Logo.astro';

interface Props {
  variant?: 'boxed' | 'fullWidth';
}

const { variant = 'boxed' } = Astro.props;

const containerClass =
  variant === 'fullWidth' ? 'w-full px-4' : 'container max-w-5xl mx-auto px-4 sm:px-6';
---

<footer class="py-12 border-t border-border/40 mt-auto bg-card/10">
  <div class="container mx-auto max-w-4xl px-4 flex flex-col items-center gap-8">

    <!-- 1. 이웃/지인 배너 영역 (88x31 사이즈 추천) -->
    <div class="flex flex-wrap justify-center gap-3 opacity-70 hover:opacity-100 transition-opacity">
      <a href="#" target="_blank" class="hover:scale-105 transition-transform">
        <img src="https://via.placeholder.com/88x31/14101f/e2e8f0?text=LINK+01" alt="배너 1" class="w-[88px] h-[31px] rounded-[2px] border border-border/50" />
      </a>
      <a href="#" target="_blank" class="hover:scale-105 transition-transform">
        <img src="https://via.placeholder.com/88x31/14101f/e2e8f0?text=LINK+02" alt="배너 2" class="w-[88px] h-[31px] rounded-[2px] border border-border/50" />
      </a>
    </div>

    <!-- 2. 외부 링크 & 방문자 카운터 영역 -->
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4 text-sm text-muted-foreground font-mono">
      
      <!-- 플랫폼 링크 -->
      <div class="flex items-center gap-4">
        <a href="https://www.postype.com/@fishstew?utm_source=link&utm_medium=social&utm_content=if_sh_wl&utm_campaign=channel" target="_blank" class="hover:text-primary transition-colors">POSTYPE</a>
        <span class="text-border">/</span>
        <a href="https://tobe.aladin.co.kr/t/joonggae" target="_blank" class="hover:text-primary transition-colors">TOBECONTINUED</a>
      </div>

      <span class="hidden sm:inline text-border">|</span>

      <!-- 방문자 카운터 (Hits 위젯) -->
      <div class="flex items-center gap-2" title="누적 방문자 수">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        <img src="https://hits.sh/mergeconflict.site.svg?style=flat-square&label=HITS&color=737373&labelColor=525252" alt="Hits" class="h-5 opacity-80 rounded-sm" />    </div>
      </div>

    <!-- 3. 카피라이트 -->
    <div class="text-xs text-muted-foreground/50 text-center font-sans">
      <p>&copy; 2026 둑중개 All Rights Reserved.</p>
    </div>

  </div>


</footer>
