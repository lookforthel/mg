---
/**
 * Base Layout (Boxed)
 *
 * The default layout for content-focused pages. Provides centered content with
 * max-width constraint (max-w-5xl), header, footer, and SEO meta tags.
 *
 * Features:
 * - Dark mode support with theme persistence
 * - View transitions for smooth page navigation
 * - Vercel Analytics integration
 * - Semantic HTML structure
 * - Complete SEO with OpenGraph and Twitter Cards
 *
 * @example
 * ```astro
 * ---
 * import BaseLayout from "@/layouts/BaseLayout.astro";
 * ---
 * <BaseLayout
 *   title="About Us"
 *   description="Learn about our company"
 * >
 *   <h1>About Page Content</h1>
 * </BaseLayout>
 * ```
 *
 * @usage
 * Use for: Blog posts, about pages, documentation, content pages
 * Don't use for: Full-width showcases (use FullWidthLayout), auth pages (use AuthLayout)
 */
import '@/styles/globals.css';
import Head from '@/components/Head.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import AnimationObserver from '@/components/AnimationObserver.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  author?: string;
  /** Exclude the page from search engines (adds robots noindex, nofollow) */
  noindex?: boolean;
}

const {
  title,
  description = 'Merge Conflict',
  image,
  type = 'website',
  publishedTime,
  author,
  noindex = false,
} = Astro.props;

// Vercel Analytics only works on Vercel deployments; rendering it elsewhere
// (local preview, other hosts) produces a 404 on /_vercel/insights/script.js
const enableAnalytics = !!process.env.VERCEL;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- 폰트 불러오기: 프리텐다드(기본) & 마루부리(본문용) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet" href="https://fastly.jsdelivr.net/gh/projectnoonnu/noonfonts_20-10-21@1.0/MaruBuri.css" />

{/* 👇 2. title에 '현재 제목 | Merge Conflict' 형태로 꼬리표를 강제 부착합니다. */}
    <Head
      title={title === 'Merge Conflict' ? title : `${title} | Merge Conflict`}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      author={author}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 bg-primary text-primary-foreground px-4 py-2 rounded-md font-medium"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    {enableAnalytics && <Analytics />}
    <AnimationObserver />
  </body>
</html>
